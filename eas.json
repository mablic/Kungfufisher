{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "false"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "large",
        "gradleCommand": ":app:bundleRelease --max-workers=2 -Dorg.gradle.parallel=false"
      }
    },
    "testflight-test-ads": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
