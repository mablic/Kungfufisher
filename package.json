{
  "name": "com.mablic.kungfufisher",
  "version": "0.2.6",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start:go": "expo start --go --ios",
    "ios:release": "expo run:ios --configuration Release --no-bundler",
    "build:ios": "node scripts/eas.mjs build --platform ios --profile production",
    "build:android": "node scripts/eas.mjs build --platform android --profile production",
    "build:android:local": "node scripts/build-android-local.mjs",
    "build:inspect:ios": "node scripts/eas.mjs build:inspect --platform ios --stage archive --profile production",
    "build:android:test": "node scripts/eas.mjs build --platform android --profile preview",
    "generate:music": "node --experimental-strip-types scripts/generate-theme-music.ts",
    "build:ios:test-ads": "node scripts/eas.mjs build --platform ios --profile testflight-test-ads",
    "ios:release:device": "expo run:ios --configuration Release --no-bundler --device"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
